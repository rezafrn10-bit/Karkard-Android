@@ -0,0 +1,23 @@
+package ir.karkard.app
+
+/**
+ * Keeps the day editor aligned with the calendar resolver. A calendar holiday must
+ * remain an official holiday in editable state as well as in reports and storage.
+ */
+internal fun enforceCalendarDayTypePolicy(
+    current: WorkDay,
+    updated: WorkDay,
+    isCalendarHoliday: Boolean
+): WorkDay {
+    if (isCalendarHoliday) {
+        return updated.copy(
+            dayType = "تعطیل رسمی",
+            dayTypeManual = false,
+            attendanceStatus = if (updated.attendanceStatus == "عادی") "" else updated.attendanceStatus
+        )
+    }
+    val categoryChanged = hasDayTypeCategoryChanged(
+        current.dayType, current.extraDayTypes, updated.dayType, updated.extraDayTypes
+    )
+    return updated.copy(dayTypeManual = updated.dayTypeManual || categoryChanged)
+}
