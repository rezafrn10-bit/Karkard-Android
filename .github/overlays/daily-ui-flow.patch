@@ -0,0 +1,52 @@
+package ir.karkard.app
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class CalendarWorkdayPolicyRegressionTest {
+    @Test
+    fun officialEidAlAdha1405CannotBeDowngradedToSpecialOrWorkingDay() {
+        val eid = Calendar1405.holidays.single { it.first == "1405-03-06" }
+        assertEquals("عید سعید قربان", eid.second)
+        val manuallySpecial = WorkDay(
+            date = eid.first,
+            dayType = "تعطیل خاص",
+            dayTypeManual = true,
+            attendanceStatus = "عادی"
+        )
+        val resolved = resolveCalendarWorkdayStatus(
+            current = manuallySpecial,
+            hasManualDayType = true,
+            isFriday = false,
+            isOfficialHoliday = true
+        )
+        assertEquals("تعطیل رسمی", resolved.dayType)
+        assertFalse(resolved.dayTypeManual)
+        assertEquals("", resolved.attendanceStatus)
+        assertTrue(isCalendarDefaultHoliday(resolved, isFriday = false, isOfficialHoliday = true))
+    }
+
+    @Test
+    fun manuallySelectedSpecialHolidaySurvivesRefreshOnAnOrdinaryDate() {
+        val special = WorkDay(date = "1405-02-12", dayType = "تعطیل خاص", dayTypeManual = true)
+        val resolved = resolveCalendarWorkdayStatus(special, true, false, false)
+        assertEquals("تعطیل خاص", resolved.dayType)
+        assertTrue(resolved.dayTypeManual)
+    }
+
+    @Test
+    fun officialCalendarHolidayCannotBeChangedToSpecialByEditorSelection() {
+        val current = WorkDay(date = "1405-03-06", dayType = "تعطیل رسمی")
+        val attempted = current.copy(
+            dayType = "تعطیل خاص",
+            dayTypeManual = true,
+            attendanceStatus = "عادی"
+        )
+        val enforced = enforceCalendarDayTypePolicy(current, attempted, isCalendarHoliday = true)
+        assertEquals("تعطیل رسمی", enforced.dayType)
+        assertFalse(enforced.dayTypeManual)
+        assertEquals("", enforced.attendanceStatus)
+    }
+}


