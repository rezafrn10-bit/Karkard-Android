+package ir.karkard.app
+
+import android.content.Context
+import android.util.Log
+import androidx.compose.ui.test.assertIsDisplayed
+import androidx.compose.ui.test.assertDoesNotExist
+import androidx.compose.ui.test.assertTextEquals
+import androidx.compose.ui.test.junit4.v2.createAndroidComposeRule
+import androidx.compose.ui.test.onNodeWithTag
+import androidx.compose.ui.test.onAllNodesWithTag
+import androidx.compose.ui.test.onRoot
+import androidx.compose.ui.test.printToLog
+import androidx.compose.ui.test.performClick
+import androidx.compose.ui.test.performImeAction
+import androidx.compose.ui.test.hasTestTag
+import androidx.compose.ui.test.performScrollToNode
+import androidx.compose.ui.test.performTextInput
+import androidx.test.core.app.ApplicationProvider
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import java.time.LocalDate
+import java.util.Locale
+import org.junit.After
+import org.junit.Assume.assumeTrue
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+
+/**
+ * Drives the real Compose screens. These tests intentionally use the same controls
+ * a person taps, then verify SQLite and the screen after navigating away and back.
+ */
+@RunWith(AndroidJUnit4::class)
+class DailyUiFlowInstrumentedTest {
+    @get:Rule
+    val composeRule = createAndroidComposeRule<MainActivity>()
+
+    private lateinit var context: Context
+    private lateinit var todayKey: String
+    private var hadOriginalDay = false
+    private var originalDay: WorkDay? = null
+    private var originalHolidayReason: String? = null
+
+    /** The time-entry row is below the initial viewport of the Home LazyColumn. */
+    private fun scrollToDailyTimeEntry() {
+        try {
+            // Wait for the Home dashboard tag itself, not assertIsDisplayed() on a
+            // potentially off-screen or not-yet-composed LazyColumn.
+            composeRule.waitUntil(30_000) {
+                composeRule.onAllNodesWithTag("daily-editor-list")
+                    .fetchSemanticsNodes().isNotEmpty()
+            }
+            composeRule.onNodeWithTag("daily-editor-list")
+                .performScrollToNode(hasTestTag("daily-entry-in-hour"))
+            composeRule.onNodeWithTag("daily-entry-in-hour").assertIsDisplayed()
+        } catch (failure: Throwable) {
+            println("DailyUiFlow setup: Home dashboard/time row unavailable; todayKey=$todayKey; failure=${failure.message}")
+            composeRule.onRoot(useUnmergedTree = true).printToLog("DailyUiFlowInitialTree")
+            throw failure
+        }
+    }
+
+    @Before
+    fun startFromAnEmptyCurrentDay() {
+        context = ApplicationProvider.getApplicationContext()
+        val (year, month, day) = gregorianToJalali(LocalDate.now())
+        todayKey = "%04d-%02d-%02d".format(Locale.ROOT, year, month, day)
+
+        val cleanupDb = WorkDb(context)
+        try {
+            // Keep the user's current-day data intact if this test is ever run on a
+            // developer device instead of the disposable CI emulator.
+            hadOriginalDay = cleanupDb.hasWorkDay(todayKey)
+            originalDay = cleanupDb.getDay(todayKey)
+            originalHolidayReason = cleanupDb.holidayTitle(todayKey)
+            val baseline = originalDay ?: WorkDay(todayKey)
+            val emptyTestDay = baseline.copy(
+                date = todayKey,
+                in1 = "", out1 = "", in2 = "", out2 = "",
+                in3 = "", out3 = "", in4 = "", out4 = "",
+                holidayIn = "", holidayOut = "",
+                leave1Start = "", leave1End = "", leave2Start = "", leave2End = "",
+                leave3Start = "", leave3End = "", leave4Start = "", leave4End = "",
+                hourlyLeaveEnabled = false, overtimeOverride = "",
+                shiftEnabled = false, shiftStart = "", shiftEnd = "",
+                shiftStartDate = "", shiftEndDate = ""
+            )
+            // Do not call deleteDay(): it also deletes independent work sessions and
+            // related multi-day shift data. Only replace this one workday row temporarily.
+            cleanupDb.saveDayAndHoliday(emptyTestDay, originalHolidayReason)
+        } finally {
+            cleanupDb.close()
+        }
+
+        // The entry row lives below the initial viewport in this LazyColumn.
+        // Scroll to it before asserting visibility; waiting alone cannot compose an off-screen item.
+        scrollToDailyTimeEntry()
+        composeRule.onNodeWithTag("navigation-report-monthly").performClick()
+        composeRule.onNodeWithTag("navigation-home").performClick()
+        // HomeDashboard is recreated at the top after leaving the screen.
+        scrollToDailyTimeEntry()
+    }
+
+    @After
+    fun removeCurrentDayTestData() {
+        if (!::context.isInitialized || !::todayKey.isInitialized) return
+        val cleanupDb = WorkDb(context)
+        try {
+            if (hadOriginalDay) {
+                cleanupDb.saveDayAndHoliday(checkNotNull(originalDay), originalHolidayReason)
+            } else {
+                // Remove only the temporary workday row; keep work sessions and shifts.
+                cleanupDb.writableDatabase.delete("workdays", "date=?", arrayOf(todayKey))
+                if (originalHolidayReason == null) cleanupDb.removeHoliday(todayKey)
+                else cleanupDb.saveHoliday(todayKey, originalHolidayReason!!)
+            }
+        } finally {
+            cleanupDb.close()
+        }
+    }
+
+    @Test
+    fun dailyEditorSavePersistsTimesAndReloadsThemAfterLeavingTheScreen() {
+        Log.i("DailyUiFlowTest", "CHECKPOINT 0: test started")
+        val readDb = WorkDb(context)
+        try {
+            // Current-day time entry uses the ordinary-workday editor. Skip only
+            // when the host's actual date is a Friday or official holiday.
+            assumeTrue(
+                "The current date is not a normal working day in the bundled calendar",
+                managementDayForDate(readDb, todayKey).dayType == "کاری"
+            )
+
+            // Recompose and scroll again after the DB check; LazyColumn may have reset
+            // its viewport while the activity finishes the initial database reload.
+            composeRule.waitForIdle()
+            scrollToDailyTimeEntry()
+            composeRule.waitForIdle()
+            Log.i("DailyUiFlowTest", "CHECKPOINT 1: before in-hour input")
+            composeRule.onNodeWithTag("daily-entry-in-hour").performClick().performTextInput("07")
+            Log.i("DailyUiFlowTest", "CHECKPOINT 2: after in-hour input")
+            composeRule.onNodeWithTag("daily-entry-in-minute").performClick().performTextInput("10")
+            composeRule.onNodeWithTag("daily-entry-out-hour").performClick().performTextInput("13")
+            composeRule.onNodeWithTag("daily-entry-out-minute").performClick().performTextInput("20")
+            Log.i("DailyUiFlowTest", "CHECKPOINT 3: before IME action")
+            composeRule.onNodeWithTag("daily-entry-out-minute").performImeAction()
+            Log.i("DailyUiFlowTest", "CHECKPOINT 4: after IME action")
+
+            composeRule.onNodeWithTag("daily-editor-list")
+                .performScrollToNode(hasTestTag("day-save-button"))
+            Log.i("DailyUiFlowTest", "CHECKPOINT 5: before save click")
+            composeRule.onNodeWithTag("day-save-button").performClick()
+            Log.i("DailyUiFlowTest", "CHECKPOINT 6: after save click")
+
+            Log.i("DailyUiFlowTest", "CHECKPOINT 7: waiting for DB persistence")
+            composeRule.waitUntil(15_000) {
+                val saved = readDb.getDay(todayKey)
+                saved.in1 == "07:10" && saved.out1 == "13:20"
+            }
+
+            Log.i("DailyUiFlowTest", "CHECKPOINT 8: DB persistence confirmed")
+            // Home is removed from composition while the monthly report is shown.
+            // Returning to Home must reload the committed row, not a stale editor copy.
+            composeRule.waitForIdle()
+            Log.i("DailyUiFlowTest", "CHECKPOINT 9: before report navigation")
+            composeRule.onNodeWithTag("navigation-report-monthly").performClick()
+            Log.i("DailyUiFlowTest", "CHECKPOINT 10: report opened")
+            composeRule.onNodeWithTag("navigation-home").performClick()
+            Log.i("DailyUiFlowTest", "CHECKPOINT 11: home reopened")
+            // Returning from the report recreates HomeDashboard at the top of its LazyColumn.
+            scrollToDailyTimeEntry()
+
+            composeRule.onNodeWithTag("daily-entry-in-hour").assertTextEquals("۰۷")
+            composeRule.onNodeWithTag("daily-entry-in-minute").assertTextEquals("۱۰")
+            composeRule.onNodeWithTag("daily-entry-out-hour").assertTextEquals("۱۳")
+            composeRule.onNodeWithTag("daily-entry-out-minute").assertTextEquals("۲۰")
+        } finally {
+            readDb.close()
+        }
+    }
+
+    @Test
+    fun monthlyReportCanManuallyReachTheCurrentDayCard() {
+        val readDb = WorkDb(context)
+        try {
+            assumeTrue(
+                "The current date is not represented in the loaded Jalali month",
+                readDb.getDay(todayKey).date == todayKey
+            )
+        } finally {
+            readDb.close()
+        }
+
+        composeRule.onNodeWithTag("navigation-report-monthly").performClick()
+        composeRule.onNodeWithTag("monthly-report-list")
+            .performScrollToNode(hasTestTag("monthly-current-day-card"))
+        composeRule.onNodeWithTag("monthly-current-day-card").assertIsDisplayed()
+    }
+
+    @Test
+    fun eidAlAdha1405IsAnOfficialHolidayInTheMonthlyCard() {
+        composeRule.onNodeWithTag("navigation-report-monthly").performClick()
+        composeRule.onNodeWithTag("monthly-year-picker").performClick()
+        composeRule.onNodeWithText("۱۴۰۵").performClick()
+        composeRule.onNodeWithTag("monthly-month-picker").performClick()
+        composeRule.onNodeWithText("خرداد").performClick()
+
+        val date = "1405-03-06"
+        composeRule.onNodeWithTag("monthly-report-list")
+            .performScrollToNode(hasTestTag("monthly-day-card-$date"))
+        composeRule.onNodeWithTag("monthly-day-card-$date").assertIsDisplayed()
+        composeRule.onNodeWithTag("monthly-holiday-card-$date").assertIsDisplayed()
+        composeRule.onNodeWithTag("monthly-day-status-$date-تعطیل رسمی").assertIsDisplayed()
+        composeRule.onNodeWithTag("monthly-day-status-$date-کاری").assertDoesNotExist()
+    }
+}
